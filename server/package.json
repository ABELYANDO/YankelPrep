{
  "name": "eduprepai-server",
  "version": "1.0.0",
  "description": "YankelPrep Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "echo 'No build step required for Node.js backend'",
    "start": "node src/index.js",
    "seed": "node scripts/seedDemo.js",
    "seed:more": "node scripts/seedDemo.js --force",
    "seed:full": "node scripts/seedQuestions.js",
    "seed:clear": "node scripts/clearQuestions.js",
    "admin:create": "node scripts/manageAdmin.js create",
    "admin:promote": "node scripts/manageAdmin.js promote",
    "extract:pdfs": "node scripts/batchExtractPdfs.js",
    "scrape:kuulchat": "node scripts/scrapeKuulchat.js",
    "grades:backfill-bece": "node scripts/backfillBeceGrades.js",
    "subjects:rename-bece-science": "node scripts/renameBeceScience.js",
    "questions:classify-existing": "node scripts/classifyExistingQuestions.js",
    "questions:migrate-structured-to-essay": "node scripts/migrateStructuredToEssay.js",
    "questions:fix-issues": "node scripts/fixQuestionBankIssues.js",
    "eval:dataset": "node scripts/evaluation/datasetStats.js",
    "eval:predictions": "node scripts/evaluation/evaluatePredictions.js",
    "eval:export-marking": "node scripts/evaluation/exportMarkingSample.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/genai": "^2.17.0",
    "@napi-rs/canvas": "^0.1.80",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
